<Window x:Class="OverlayAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Interstellar" Width="560" Height="760" MinWidth="400" MinHeight="480"
        Left="80" Top="80" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Topmost="True" ShowActivated="True" Background="#080E19"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#111C2D" Offset="0"/>
      <GradientStop Color="#0A1220" Offset="0.52"/>
      <GradientStop Color="#111525" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#718DAA" Offset="0"/>
      <GradientStop Color="#29465F" Offset="0.45"/>
      <GradientStop Color="#35405F" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#DCEBFA"/>
      <Setter Property="Background" Value="#18283A"/>
      <Setter Property="BorderBrush" Value="#38516B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="10">
              <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.10" Color="#000000"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#24415A"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#58BFD5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="#071522"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9AF4F1" Offset="0"/>
            <GradientStop Color="#5BCDE0" Offset="0.55"/>
            <GradientStop Color="#66A9EC" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#A5F5F5"/>
      <Setter Property="Padding" Value="15,8"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Background" Value="#152437"/>
      <Setter Property="BorderBrush" Value="#2D435B"/>
    </Style>
    <Style x:Key="TabBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8FA5BA"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Padding="13,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="10">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#20354A"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#416A83"/>
                <Setter Property="Foreground" Value="#F0FAFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A2B3E"/>
                <Setter Property="Foreground" Value="#D6F8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#91A8BD"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,15,0,6"/>
    </Style>
    <Style x:Key="Inp" TargetType="TextBox">
      <Setter Property="Background" Value="#101C2B"/>
      <Setter Property="Foreground" Value="#E8F4FF"/>
      <Setter Property="CaretBrush" Value="#7EE7F0"/>
      <Setter Property="BorderBrush" Value="#344B63"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#C9DCEB"/>
      <Setter Property="Background" Value="#132237"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="2,2,2,0"/>
    </Style>
  </Window.Resources>

  <Grid Background="Transparent">
    <Border x:Name="FullShell" Margin="5" CornerRadius="21" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}" Background="{StaticResource ShellBrush}">
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.20" Color="#000000"/></Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72"/>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="20,20,0,0" Background="#B0182A40" BorderBrush="#294761" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseDown">
          <Grid Margin="14,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="13" BorderBrush="#5489A7" BorderThickness="1" Background="#101C2D" ClipToBounds="True" VerticalAlignment="Center">
              <Image Source="pack://application:,,,/Assets/Branding/interstellar-signal.png" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
              <TextBlock Text="INTERSTELLAR" Foreground="#F1F8FF" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="A little more space to think" Foreground="#8FA9C0" FontSize="10.5" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="⚙" Style="{StaticResource IconButton}" Margin="0,0,7,0" Click="Settings_Click" ToolTip="AI settings"/>
            <Button Grid.Column="3" Content="–" Style="{StaticResource IconButton}" Margin="0,0,7,0" Click="Hide_Click" ToolTip="Hide overlay · Ctrl+Shift+Space to bring it back" FontSize="20"/>
            <Button Grid.Column="4" Content="×" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Exit Interstellar" FontSize="18"/>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#68111D2B" BorderBrush="#253D54" BorderThickness="0,0,0,1">
          <Grid Margin="13,0,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <RadioButton x:Name="TabAssistant" Grid.Column="0" Content="✦  Assistant" Tag="Assistant" GroupName="mainTabs" IsChecked="True" Style="{StaticResource TabBtn}" Click="Tab_Click"/>
            <RadioButton x:Name="TabBrowser" Grid.Column="1" Content="◉  Browser" Tag="Browser" GroupName="mainTabs" Style="{StaticResource TabBtn}" Click="Tab_Click"/>
            <RadioButton x:Name="TabVpn" Grid.Column="2" Content="◇  VPN" Tag="VPN" GroupName="mainTabs" Style="{StaticResource TabBtn}" Click="Tab_Click"/>
            <TextBlock x:Name="StatusText" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="#7592AA" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
          </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="1">
          <!-- Assistant -->
          <Grid x:Name="ChatPanel">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <wv2:WebView2 x:Name="ChatView" Grid.Row="0"/>
            <Border x:Name="ThumbBar" Grid.Row="1" Visibility="Collapsed" Background="#D91A2A3D" BorderBrush="#36536C" BorderThickness="1,1,1,0" Padding="10,8" CornerRadius="13,13,0,0" Margin="10,0,10,0">
              <DockPanel LastChildFill="True">
                <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="15" Click="ThumbClose_Click" ToolTip="Remove attached image"/>
                <Border BorderBrush="#5686A3" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Width="64" Height="48" VerticalAlignment="Center">
                  <Image x:Name="Thumb" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock x:Name="ThumbTitle" Text="SCREEN CLIP ATTACHED" Foreground="#D9F6FF" FontSize="9" FontWeight="Bold"/>
                  <TextBlock x:Name="ThumbSubtitle" Text="Ready to send with your next message" Foreground="#8FA9BF" FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="#D8101C2B" BorderBrush="#2C455D" BorderThickness="0,1,0,0" Padding="10,10,10,11" CornerRadius="0,0,19,19">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="▣" Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="Capture_Click" ToolTip="Clip the primary screen · Ctrl+Shift+S" FontSize="16"/>
                <Border Grid.Column="1" Background="#111F30" BorderBrush="#34516B" BorderThickness="1" CornerRadius="13" Padding="3,1">
                  <TextBox x:Name="PromptBox" Background="Transparent" BorderThickness="0" Foreground="#EAF5FF" CaretBrush="#72E3EE"
                           Padding="8,7" FontSize="12.5" MaxHeight="100" MinHeight="34" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalContentAlignment="Center" PreviewKeyDown="Prompt_KeyDown" ToolTip="Ask something · Enter to send · Shift+Enter for a new line"/>
                </Border>
                <Button x:Name="SendBtn" Grid.Column="2" Content="↑" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Padding="0" Width="38" Height="36"
                        FontSize="18" Click="Send_Click" ToolTip="Send message"/>
              </Grid>
            </Border>
          </Grid>

          <!-- Browser with independent, addable tabs -->
          <Grid x:Name="BrowserPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#D817283A" BorderBrush="#2C455D" BorderThickness="0,0,0,1" Padding="10,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="‹" Style="{StaticResource IconButton}" Click="Back_Click" FontSize="20"/>
                <Button Grid.Column="1" Content="›" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Fwd_Click" FontSize="20"/>
                <TextBox x:Name="UrlBox" Grid.Column="2" Style="{StaticResource Inp}" Margin="8,0" Padding="10,7" VerticalContentAlignment="Center" KeyDown="Url_KeyDown"/>
                <Button Grid.Column="3" Content="Go" Style="{StaticResource ActionButton}" Padding="13,7" Click="Go_Click"/>
                <Button Grid.Column="4" Content="+" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="NewBrowserTab_Click" ToolTip="Open another browser tab" FontSize="20"/>
              </Grid>
            </Border>
            <TabControl x:Name="BrowserTabs" Grid.Row="1" Background="#0C1624" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged"/>
          </Grid>

          <!-- Windows VPN profiles -->
          <ScrollViewer x:Name="VpnPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <StackPanel Margin="20,18,20,22">
              <Border Background="#421E3850" BorderBrush="#335570" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="PRIVATE CONNECTION" Foreground="#7EE4EA" FontSize="9.5" FontWeight="Bold"/>
                  <TextBlock Text="Windows VPN" Foreground="#F0F7FF" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,3"/>
                  <TextBlock Text="Connect to VPN profiles already configured on this PC. Interstellar does not store VPN passwords or provide a VPN subscription. Use Windows Settings for profiles that need an interactive sign-in." Foreground="#9AB0C4" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBlock Text="CONFIGURED VPN PROFILE" Style="{StaticResource Lbl}" Margin="0,6,0,6"/>
              <ComboBox x:Name="VpnProfileBox" Height="38" Background="#101C2B" Foreground="#E8F4FF" BorderBrush="#344B63" BorderThickness="1" Padding="8"/>
              <WrapPanel Margin="0,14,0,0">
                <Button Content="Connect" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="VpnConnect_Click" Margin="0,0,8,8"/>
                <Button Content="Disconnect" Style="{StaticResource ActionButton}" Padding="16,9" Click="VpnDisconnect_Click" Margin="0,0,8,8"/>
                <Button Content="Refresh" Style="{StaticResource ActionButton}" Padding="16,9" Click="VpnRefresh_Click" Margin="0,0,8,8"/>
              </WrapPanel>
              <Border Background="#26101B29" BorderBrush="#33445A70" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="CONNECTION STATUS" Foreground="#7EE4EA" FontSize="9" FontWeight="Bold"/>
                  <TextBlock x:Name="VpnStatusText" Text="Choose Refresh to find Windows VPN profiles." Foreground="#D2E4F2" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
              <Button Content="Open Windows VPN settings" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Padding="14,8" Margin="0,14,0,0" Click="VpnOpenSettings_Click"/>
              <TextBlock Text="Only Windows built-in VPN profiles are managed here. For a third-party VPN app, connect using that provider's own client." Foreground="#7F9AB1" FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Settings -->
          <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" Background="Transparent" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,22">
              <Border Background="#421E3850" BorderBrush="#335570" BorderThickness="1" CornerRadius="17" Padding="16" Margin="0,0,0,5">
                <StackPanel>
                  <TextBlock Text="THE ENGINE ROOM" Foreground="#7EE4EA" FontSize="9.5" FontWeight="Bold"/>
                  <TextBlock Text="Connect your intelligence" Foreground="#F0F7FF" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,3"/>
                  <TextBlock Text="Choose the model that powers your assistant. Your provider and model preferences are saved on this device." Foreground="#9AB0C4" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Background="#2E1C3044" BorderBrush="#456C83" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,0,8">
                <StackPanel>
                  <CheckBox x:Name="FastModeToggle" Content="Fast responses" IsChecked="True" Foreground="#EAF5FF" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="Uses a shorter conversation context and lower response-length limit to reduce latency and token usage." Foreground="#9AB0C4" FontSize="10.5" TextWrapping="Wrap" Margin="22,4,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="AI PROVIDER" Style="{StaticResource Lbl}"/>
              <WrapPanel>
                <RadioButton x:Name="RbOpenAi" Content="OpenAI" Tag="openai" GroupName="prov" Style="{StaticResource TabBtn}" Click="Provider_Click"/>
                <RadioButton x:Name="RbAnthropic" Content="Claude" Tag="anthropic" GroupName="prov" Style="{StaticResource TabBtn}" Click="Provider_Click"/>
                <RadioButton x:Name="RbGemini" Content="Gemini" Tag="gemini" GroupName="prov" Style="{StaticResource TabBtn}" Click="Provider_Click"/>
                <RadioButton x:Name="RbOllama" Content="Ollama · local" Tag="ollama" GroupName="prov" Style="{StaticResource TabBtn}" Click="Provider_Click"/>
              </WrapPanel>
              <TextBlock Text="BASE URL" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="BaseUrlBox" Style="{StaticResource Inp}"/>
              <TextBlock Text="MODEL" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="ModelBox" Style="{StaticResource Inp}"/>
              <TextBlock Text="API KEY" Style="{StaticResource Lbl}"/>
              <PasswordBox x:Name="KeyBox" Background="#101C2B" Foreground="#E8F4FF" CaretBrush="#7EE7F0" BorderBrush="#344B63" BorderThickness="1" Padding="10,8"/>
              <TextBlock Text="Keys saved here are encrypted with Windows DPAPI for your Windows user. Keys supplied through .env files or environment variables remain your responsibility. Ollama does not need a key." Foreground="#7F9AB1" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button Content="Save connection" Margin="0,20,0,0" HorizontalAlignment="Left" Padding="20,9" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
