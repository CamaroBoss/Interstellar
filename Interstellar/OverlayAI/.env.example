# Copy to ".env" next to Interstellar.exe (or to %APPDATA%\OverlayAI\.env).
# Values saved from the in-app Settings panel (config.json) take precedence over these.

# openai | anthropic | gemini | ollama
AI_PROVIDER=ollama
# Leave blank to use each provider's default model / URL
AI_MODEL=
AI_BASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
